// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
//  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================
enum Role {
  SUPER_ADMIN   // Dono do SaaS (Ação Leve)
  ORG_ADMIN     // O Cliente (ex: Contratante)
  OPERATOR      // O Locutor do Bingo
  VERIFIER      // O Voluntário/Fiscal de pátio
}

enum PrizeType {
  QUINA
  FULL_HOUSE
}

enum PaymentMethod {
  PIX
  CASH   // Dinheiro vivo
  CARD   // Débito/Crédito
}

// ==========================================
// MODELS
// ==========================================

// 🏢 TENANT (Inquilino do SaaS)
model Tenant {
  id          String   @id @default(cuid())
  name        String
  subdomain   String   @unique
  logoUrl     String?
  active      Boolean  @default(true)
  token       String?
  isActive Boolean @default(true)

  users       User[]
  events      Event[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tenants")
}

// 👤 USERS (Autenticação Unificada)
model User {
  id          String   @id @default(cuid())
  name        String?
  email       String   @unique
  password    String?
  role        Role     @default(ORG_ADMIN)
  operator    String?
  
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("users")
}

// 🎉 EVENTS (O Evento de Bingo)
model Event {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  status            String   @default("DRAFT")
  drawnNumbers      Int[]    @default([])
  isActive          Boolean  @default(false)
  showBoard         Boolean  @default(true)
  ticketPrice       Float    @default(10.00)
  
  // Celebração em 3 vias
  pendingWinnerCard String?
  pendingWinnerName String?
  bingoConfirmed    Boolean  @default(false)
  bingoConfirmedAt  DateTime?

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Relações
  sellers           Seller[]
  cards             Card[]
  sponsors          Sponsor[]
  prizes            Prize[]
  transactions      Transaction[] // 🔥 Adicionado para o Relatório Financeiro

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
  @@map("events")
}

// 🤝 SPONSORS (Patrocinadores do Telão)
model Sponsor {
  id            String   @id @default(cuid())
  eventId       String
  name          String
  logoUrl       String?
  contribution  Int      @default(0)
  order         Int      @default(0)
  
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("sponsors")
}

// 🎟️ CARDS (Cartelas)
model Card {
  id            String   @id @default(cuid())
  shortId       String   @unique
  matrix        Json
  isSold        Boolean  @default(false)
  
  sellerId      String?
  isPaid        Boolean  @default(false)
  price         Float?

  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seller        Seller?  @relation(fields: [sellerId], references: [id])
  
  transactions  Transaction[] // 🔥 Adicionado para o Relatório Financeiro

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([eventId])
  @@index([shortId])
  @@map("cards")
}

// 👥 SELLERS (Vendedores Físicos)
model Seller {
  id            String   @id @default(cuid())
  eventId       String
  name          String
  phone         String?
  
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  cards         Card[]
  transactions  Transaction[] // 🔥 Adicionado para o Relatório Financeiro

  createdAt     DateTime @default(now())

  @@map("sellers")
}

// 🏆 PRIZES (Rodadas/Prêmios)
model Prize {
  id            String    @id @default(cuid())
  eventId       String
  name          String
  type          PrizeType
  prizeName     String
  order         Int
  isCompleted   Boolean   @default(false)
  winnerId      String?
  
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("prizes")
}

// 💰 TRANSACTIONS (Extrato Financeiro)
model Transaction {
  id            String        @id @default(cuid())
  eventId       String
  cardId        String?
  sellerId      String?
  amount        Float
  method        PaymentMethod
  
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  card          Card?         @relation(fields: [cardId], references: [id], onDelete: SetNull)
  seller        Seller?       @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  createdAt     DateTime      @default(now())

  @@map("transactions")
}

// 🛡️ AUDIT LOGS (Registro de Integridade)
model AuditLog {
  id            String   @id @default(cuid())
  action        String
  userId        String?
  tenantId      String?
  metadata      Json?
  
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@map("audit_logs")
}