// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

// 🔐 ROLES (O coração da autorização unificada)
enum Role {
  SUPER_ADMIN   // Você (Dono do SaaS)
  ORG_ADMIN     // O Cliente (ex: João da Paróquia)
  OPERATOR      // O Locutor do Bingo
  VERIFIER      //  Nova função para o voluntário de pátio
}

// 🏢 TENANT (Substitui a antiga "Organization" - Inquilino do SaaS)
model Tenant {
  id        String   @id @default(cuid())
  name      String
  subdomain String   @unique // ex: saobento, rotary
  logoUrl   String?
  active    Boolean  @default(true)
  token     String?

  users     User[]
  events    Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 👤 USERS (Unifica Donos e Operadores na mesma tabela de autenticação)
model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?  // Hashed via bcrypt
  role      Role     @default(ORG_ADMIN)
  operator  String?
  // RELAÇÃO COM TENANT
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId]) // Otimiza a busca quando listarmos "Todos os usuários de um Tenant"
}

// 🎉 EVENTS
model Event {
  id           String   @id @default(cuid())
  name         String
  status       String   @default("DRAFT")
  drawnNumbers Int[]    @default([])
  isActive     Boolean  @default(false)
  showBoard    Boolean  @default(true) // 🔥 A nova chave do Modo Hardcore
  sellers      Seller[]
  cards        Card[]

  // RELAÇÃO COM TENANT (Garante o isolamento dos dados)
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sponsors     Sponsor[]


  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  prizes Prize[]
}

// 🤝 SPONSORS
model Sponsor {
  id        String  @id @default(cuid())
  name      String
  logoUrl   String?
  contribution  Int      @default(0)     // valor em centavos (R$ 500,00 = 50000)
  order         Int      @default(0)     // para reordenação manual
  
  // RELAÇÃO COM EVENT
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// 🎟️ CARDS
// 🎟️ CARDS
model Card {
  id        String   @id @default(cuid())
  shortId   String   @unique
  matrix    Json
  isSold    Boolean  @default(false)

  // 🔥 Campos financeiros
  sellerId  String?
  isPaid    Boolean  @default(false)
  price     Float?

  // Relações
  seller    Seller?  @relation(fields: [sellerId], references: [id])
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([shortId])
  @@map("cards")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  userId    String?
  tenantId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model Seller {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  phone     String?
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  cards     Card[]   // Um vendedor pode ter um lote de cartelas na mão dele

  @@map("sellers")
}

// Nova model para as Rodadas do Evento
model Prize {
  id          String   @id @default(cuid())
  eventId     String
  name        String   // Ex: "1ª Rodada - Quina"
  type        PrizeType // Enum: QUINA, FULL_HOUSE
  prizeName   String   // Ex: "Cesta de Natal"
  order       Int      // Para saber qual rodada vem primeiro
  isCompleted Boolean  @default(false)

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

enum PrizeType {
  QUINA
  FULL_HOUSE
}