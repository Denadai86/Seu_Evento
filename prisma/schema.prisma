// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS (Domínios de Valores Fixos)
// ==========================================
enum Role {
  SUPER_ADMIN   // God Mode (Dono da plataforma)
  ORG_ADMIN     // Dono do Tenant (Cliente)
  STAFF         // Membro da equipe (Escalável via EventStaff)
}

enum PrizeType {
  QUINA
  FULL_HOUSE
}

enum PaymentMethod {
  PIX
  CASH
  CARD
}

enum PlanType {
  SINGLE_EVENT
  THREE_EVENTS
  ANNUAL
}

// ==========================================
// MODELS (Entidades do Domínio)
// ==========================================

// 🏢 TENANT (Organização/Cliente B2B)
model Tenant {
  id          String    @id @default(cuid())
  name        String
  subdomain   String    @unique
  
  // 🔥 Novos Dados Cadastrais Adicionados
  document    String?   // CPF ou CNPJ
  phone       String?   // Telefone/WhatsApp
  
  logoUrl     String?
  active      Boolean   @default(true)
  token       String?   // Token Mágico de Impersonation (uso único)
  tokenExpiresAt DateTime? // Validade do token mágico (10 minutos)
  
  planType    PlanType  @default(SINGLE_EVENT)
  expiresAt   DateTime? // Data limite de acesso
  // Eventos que ainda podem ser criados. null = ilimitado (Anual e clientes antigos).
  // Evento Único nasce com 1, 3 Eventos nasce com 3. Cada evento criado consome 1.
  eventCredits Int?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users       User[]
  events      Event[]

  @@map("tenants")
}

// 👤 USERS (Identidade Global)
model User {
  id          String    @id @default(cuid())
  name        String?
  email       String?   @unique  
  username    String?   @unique  // Credencial para STAFF (Ex: JOAO123)
  password    String?
  role        Role      @default(ORG_ADMIN)
  
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Escalas/Permissões desta pessoa em eventos específicos
  staffAssignments EventStaff[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Quando a pessoa viu o aviso de boas-vindas da Central de Ajuda (aparece uma única vez).
  manualSeenAt DateTime?

  @@index([tenantId])
  @@map("users")
}

// 🎉 EVENTS (O Evento)
model Event {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  status            String   @default("DRAFT")
  drawnNumbers      Int[]    @default([])
  isActive          Boolean  @default(false)
  showBoard         Boolean  @default(true)
  // Rodízio de patrocinadores: nº total de pedras sorteadas no evento (NÃO zera ao trocar de rodada)
  sponsorCursor     Int      @default(0)
  ticketPrice       Float    @default(10.00)
  // Preço da CARTELA CHEIA (centavos). null = ainda não definido (não dá para gerar/vender cartela cheia).
  fullHousePrice    Float?
  pixKey            String?
  // Modelo visual da cartela impressa (tema, colorido/P&B, data/local/causa, canhoto). JSON para não enrijecer.
  cardDesign        Json?
  
  // Celebração de Bingo (State)
  pendingWinnerCard String?
  pendingWinnerName String?
  bingoConfirmed    Boolean  @default(false)
  bingoConfirmedAt  DateTime?

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  staff             EventStaff[]
  cards             Card[]
  sponsors          Sponsor[]
  prizes            Prize[]
  transactions      Transaction[] 

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
  exposures     SponsorExposure[]
  priceTiers    PriceTier[]
  cardTransfers CardTransfer[]
  bingoClaims   BingoClaim[]

  @@map("events")
}

// 🚀 EVENT STAFF (Controle Granular de Permissões/Equipe)
model EventStaff {
  id          String   @id @default(cuid())
  eventId     String
  userId      String
  
  // Permissões isoladas por evento
  canSell     Boolean  @default(true)
  canOperate  Boolean  @default(false)
  canVerify   Boolean  @default(false)
  // Papéis de gestão (por evento). Tesoureiro: tesouraria, extratos, fechamento e cartelas.
  // Conselho: leitura de painel, relatórios e auditoria. O administrador define quem tem o quê.
  canTreasury  Boolean  @default(false)
  canAudit     Boolean  @default(false)

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  cards       Card[]
  transactions Transaction[]
  transfersRequested CardTransfer[] @relation("TransferRequester")
  transfersOwned     CardTransfer[] @relation("TransferOwner")

  createdAt   DateTime @default(now())

  @@unique([eventId, userId]) // Garante que o usuário não seja escalado 2x no mesmo evento
  @@map("event_staff")
}

// 🤝 SPONSORS (Patrocinadores)
model Sponsor {
  id            String   @id @default(cuid())
  eventId       String
  name          String
  logoUrl       String?
  contribution  Int      @default(0)
  order         Int      @default(0)
  
  prizes        Prize[]  
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  exposures     SponsorExposure[]

  @@index([eventId])
  @@map("sponsors")
}

// 🎟️ CARDS (Cartelas)
model Card {
  id            String      @id @default(cuid())
  shortId       String      @unique
  matrix        Json
  isSold        Boolean     @default(false)
  isPaid        Boolean     @default(false)
  price         Float?
  // Tipo da cartela: só concorre a prêmios do MESMO tipo. null = cartela antiga (vale para qualquer prêmio).
  type          PrizeType?
  // Cartela PERDIDA/cancelada: não pode ser vendida, entregue, transferida nem premiada.
  blocked       Boolean     @default(false)
  blockedAt     DateTime?
  blockedReason String?
  isDemoCard    Boolean     @default(false)

  eventId       String
  eventStaffId  String?

  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staff         EventStaff? @relation(fields: [eventStaffId], references: [id], onDelete: SetNull)
  transactions  Transaction[] 

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([eventId])
  @@index([shortId])
  @@map("cards")
}

// 🏆 PRIZES (Prêmios)
model Prize {
  id          String    @id @default(cuid())
  eventId     String
  name        String
  type        PrizeType
  prizeName   String
  order       Int
  isCompleted Boolean   @default(false)
  winnerId    String?
  
  sponsorId   String?
  sponsor     Sponsor?  @relation(fields: [sponsorId], references: [id], onDelete: SetNull)
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  claims      BingoClaim[]

  @@map("prizes")
}

// 💰 TRANSACTIONS (Financeiro)
model Transaction {
  id            String        @id @default(cuid())
  eventId       String
  cardId        String?
  eventStaffId  String?
  amount        Float
  method        PaymentMethod
  // Agrupa as cartelas de UM mesmo fechamento de venda no PDV (permite desfazer a última venda).
  batchId       String?
  
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  card          Card?         @relation(fields: [cardId], references: [id], onDelete: SetNull)
  staff         EventStaff?   @relation(fields: [eventStaffId], references: [id], onDelete: SetNull)

  createdAt     DateTime      @default(now())

  @@map("transactions")
}

// 🛡️ AUDIT LOGS
model AuditLog {
  id          String   @id @default(cuid())
  action      String
  userId      String?
  tenantId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ==========================================
// EXPOSIÇÃO DE PATROCINADORES
// Uma linha por pedra sorteada: qual patrocinador "ofereceu" aquela pedra no telão.
// É a base do Relatório de Exposição (prova de entrega para o patrocinador).
// ==========================================
model SponsorExposure {
  id          String   @id @default(cuid())
  eventId     String
  sponsorId   String?
  sponsorName String   // cópia do nome: o relatório continua certo se o patrocinador for removido depois
  ballNumber  Int
  sequence    Int      // nº da pedra no evento (1 = primeira), contando todas as rodadas
  createdAt   DateTime @default(now())

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sponsor     Sponsor? @relation(fields: [sponsorId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@map("sponsor_exposures")
}

// ==========================================
// FASES DE PREÇO
// O preço da cartela muda com a data (pré-venda, perto do evento, no evento). Só o admin define.
// A fase vigente é a de maior `startsAt` que já começou; sem nenhuma fase vigente vale o preço
// padrão do evento. O preço cobrado fica gravado em Card.price na hora da venda, então trocar de
// fase NUNCA altera cartelas já vendidas.
// ==========================================
model PriceTier {
  id             String    @id @default(cuid())
  eventId        String
  name           String
  quinaPrice     Float     // centavos
  fullHousePrice Float?    // centavos; null = usa o preço padrão da cartela cheia do evento
  startsAt       DateTime? // null = vale desde o início (só pode haver uma fase assim)
  createdAt      DateTime  @default(now())

  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, startsAt])
  @@map("price_tiers")
}

// ==========================================
// PEDIDOS DE CARTELAS ENTRE VOLUNTÁRIOS
// "Preciso de mais 5": o voluntário PEDE a outro pelo PDV e o outro libera.
// Ao aceitar, as cartelas mudam de dono NO SISTEMA (registro completo, com os códigos),
// para o acerto e a validação do ganhador continuarem batendo com as cartelas físicas.
// ==========================================
enum TransferStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model CardTransfer {
  id          String         @id @default(cuid())
  eventId     String
  requesterId String         // EventStaff que PEDIU as cartelas
  ownerId     String         // EventStaff que TEM as cartelas e libera
  type        PrizeType      // Quina ou Cartela Cheia
  quantity    Int
  status      TransferStatus @default(PENDING)
  codes       Json?          // códigos transferidos (preenchido ao aceitar)
  createdAt   DateTime       @default(now())
  respondedAt DateTime?

  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  requester   EventStaff     @relation("TransferRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  owner       EventStaff     @relation("TransferOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
  @@index([ownerId, status])
  @@map("card_transfers")
}

// ==========================================
// FILA DE AVISOS DE BINGO (ganhadores simultâneos)
// Todo aviso válido entra aqui; o LOCUTOR decide na hora: um ganhador (os outros cedem) ou prêmio dividido.
// ==========================================
enum ClaimStatus {
  PENDING   // aguardando a decisão do locutor
  WINNER    // ganhador (um só, ou um dos que dividem o prêmio)
  YIELDED   // cedeu para o(s) outro(s)
  DISCARDED // descartado pelo locutor (falso alarme, erro de nome…)
}

model BingoClaim {
  id           String      @id @default(cuid())
  eventId      String
  prizeId      String      // a rodada em que o aviso foi feito
  cardShortId  String
  claimantName String      // nome informado pelo fiscal
  fiscalName   String
  fiscalUserId String?
  closedAtDraw Int?        // em qual pedra (1ª, 2ª…) a cartela fechou o padrão: desempate objetivo
  drawnCount   Int         @default(0) // quantas pedras já tinham saído quando o fiscal avisou
  status       ClaimStatus @default(PENDING)
  // "rodada:cartela" enquanto o aviso está ATIVO; NULL quando descartado (permite reenviar com o nome corrigido).
  // O UNIQUE impede, no banco, a mesma cartela duas vezes na fila (dois fiscais avisando juntos).
  activeKey    String?     @unique
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime    @default(now())

  event        Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  prize        Prize       @relation(fields: [prizeId], references: [id], onDelete: Cascade)

  @@index([eventId, prizeId, status])
  @@map("bingo_claims")
}
