// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS (Domínios de Valores Fixos)
// ==========================================
enum Role {
  SUPER_ADMIN   // God Mode (Dono da plataforma)
  ORG_ADMIN     // Dono do Tenant (Cliente)
  STAFF         // Membro da equipe (Escalável via EventStaff)
}

enum PrizeType {
  QUINA
  FULL_HOUSE
}

enum PaymentMethod {
  PIX
  CASH
  CARD
}

enum PlanType {
  SINGLE_EVENT
  ANNUAL
}

// ==========================================
// MODELS (Entidades do Domínio)
// ==========================================

// 🏢 TENANT (Organização/Cliente B2B)
model Tenant {
  id          String    @id @default(cuid())
  name        String
  subdomain   String    @unique
  
  // 🔥 Novos Dados Cadastrais Adicionados
  document    String?   // CPF ou CNPJ
  phone       String?   // Telefone/WhatsApp
  
  logoUrl     String?
  active      Boolean   @default(true)
  token       String?   // Token Mágico de Impersonation
  
  planType    PlanType  @default(SINGLE_EVENT)
  expiresAt   DateTime? // Data limite de acesso
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users       User[]
  events      Event[]

  @@map("tenants")
}

// 👤 USERS (Identidade Global)
model User {
  id          String    @id @default(cuid())
  name        String?
  email       String?   @unique  
  username    String?   @unique  // Credencial para STAFF (Ex: JOAO123)
  password    String?
  role        Role      @default(ORG_ADMIN)
  
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Escalas/Permissões desta pessoa em eventos específicos
  staffAssignments EventStaff[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@map("users")
}

// 🎉 EVENTS (O Evento)
model Event {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  status            String   @default("DRAFT")
  drawnNumbers      Int[]    @default([])
  isActive          Boolean  @default(false)
  showBoard         Boolean  @default(true)
  ticketPrice       Float    @default(10.00)
  pixKey            String?
  
  // Celebração de Bingo (State)
  pendingWinnerCard String?
  pendingWinnerName String?
  bingoConfirmed    Boolean  @default(false)
  bingoConfirmedAt  DateTime?

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  staff             EventStaff[]
  cards             Card[]
  sponsors          Sponsor[]
  prizes            Prize[]
  transactions      Transaction[] 

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
  @@map("events")
}

// 🚀 EVENT STAFF (Controle Granular de Permissões/Equipe)
model EventStaff {
  id          String   @id @default(cuid())
  eventId     String
  userId      String
  
  // Permissões isoladas por evento
  canSell     Boolean  @default(true)
  canOperate  Boolean  @default(false)
  canVerify   Boolean  @default(false)

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  cards       Card[]
  transactions Transaction[]

  createdAt   DateTime @default(now())

  @@unique([eventId, userId]) // Garante que o usuário não seja escalado 2x no mesmo evento
  @@map("event_staff")
}

// 🤝 SPONSORS (Patrocinadores)
model Sponsor {
  id            String   @id @default(cuid())
  eventId       String
  name          String
  logoUrl       String?
  contribution  Int      @default(0)
  order         Int      @default(0)
  
  prizes        Prize[]  
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("sponsors")
}

// 🎟️ CARDS (Cartelas)
model Card {
  id            String      @id @default(cuid())
  shortId       String      @unique
  matrix        Json
  isSold        Boolean     @default(false)
  isPaid        Boolean     @default(false)
  price         Float?
  isDemoCard    Boolean     @default(false)

  eventId       String
  eventStaffId  String?

  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staff         EventStaff? @relation(fields: [eventStaffId], references: [id], onDelete: SetNull)
  transactions  Transaction[] 

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([eventId])
  @@index([shortId])
  @@map("cards")
}

// 🏆 PRIZES (Prêmios)
model Prize {
  id          String    @id @default(cuid())
  eventId     String
  name        String
  type        PrizeType
  prizeName   String
  order       Int
  isCompleted Boolean   @default(false)
  winnerId    String?
  
  sponsorId   String?
  sponsor     Sponsor?  @relation(fields: [sponsorId], references: [id], onDelete: SetNull)
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("prizes")
}

// 💰 TRANSACTIONS (Financeiro)
model Transaction {
  id            String        @id @default(cuid())
  eventId       String
  cardId        String?
  eventStaffId  String?
  amount        Float
  method        PaymentMethod
  
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  card          Card?         @relation(fields: [cardId], references: [id], onDelete: SetNull)
  staff         EventStaff?   @relation(fields: [eventStaffId], references: [id], onDelete: SetNull)

  createdAt     DateTime      @default(now())

  @@map("transactions")
}

// 🛡️ AUDIT LOGS
model AuditLog {
  id          String   @id @default(cuid())
  action      String
  userId      String?
  tenantId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@map("audit_logs")
}