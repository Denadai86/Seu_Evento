// src/features/tesouraria/components/TreasuryClient.tsx
"use client";

import { useState, useTransition } from "react";
import { assignCardsToStaff, returnCardsFromStaff } from "../actions";
import { PackagePlus, PackageMinus, Users, TrendingUp } from "lucide-react";

export default function TreasuryClient({ eventId, initialStaff }: { 
  eventId: string; 
  initialStaff: any[] 
}) {
  const [activeStaff, setActiveStaff] = useState<any>(null);
  const [modalType, setModalType] = useState<"assign" | "return" | null>(null);
  const [batchInput, setBatchInput] = useState("");
  const [message, setMessage] = useState("");
  const [isPending, startTransition] = useTransition();

  const openModal = (staff: any, type: "assign" | "return") => {
    setActiveStaff(staff);
    setModalType(type);
    setBatchInput("");
    setMessage("");
  };

  const handleProcess = async () => {
    if (!batchInput.trim() || !activeStaff) return;

    const codes = batchInput.toUpperCase().split(/[\s,]+/).filter(Boolean);

    startTransition(async () => {
      let res;
      if (modalType === "assign") {
        res = await assignCardsToStaff(eventId, activeStaff.id, codes);
      } else {
        res = await returnCardsFromStaff(eventId, activeStaff.id, codes);
      }

      if (res.success) {
        setMessage(`✅ ${res.count} cartelas processadas com sucesso!`);
        setBatchInput("");
        // Refresh manual (ou usar router.refresh se estiver usando)
        window.location.reload();
      } else {
        setMessage(`❌ ${res.error}`);
      }
    });
  };

  return (
    <div className="space-y-6">
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {initialStaff.map((staff: any) => {
          const assigned = staff.cards.length;
          const sold = staff.cards.filter((c: any) => c.isPaid).length;
          const pending = assigned - sold;

          return (
            <div key={staff.id} className="bg-slate-900 border border-slate-700 rounded-3xl p-6 hover:border-emerald-500/30 transition-all">
              <div className="flex items-center gap-3 mb-4">
                <Users className="text-slate-400" size={28} />
                <div>
                  <h3 className="font-bold text-lg text-white">{staff.user.name}</h3>
                  <p className="text-xs text-slate-500">ID: {staff.id.slice(0,8)}</p>
                </div>
              </div>

              <div className="grid grid-cols-3 gap-3 mb-6 text-center">
                <div>
                  <p className="text-2xl font-black text-blue-400">{assigned}</p>
                  <p className="text-[10px] text-slate-500">Atribuídas</p>
                </div>
                <div>
                  <p className="text-2xl font-black text-emerald-400">{sold}</p>
                  <p className="text-[10px] text-slate-500">Vendidas</p>
                </div>
                <div>
                  <p className="text-2xl font-black text-orange-400">{pending}</p>
                  <p className="text-[10px] text-slate-500">Pendentes</p>
                </div>
              </div>

              <div className="flex gap-2">
                <button
                  onClick={() => openModal(staff, "assign")}
                  className="flex-1 bg-blue-600 hover:bg-blue-500 py-3 rounded-xl text-sm font-bold flex items-center justify-center gap-2"
                >
                  <PackagePlus size={18} /> Entregar
                </button>
                <button
                  onClick={() => openModal(staff, "return")}
                  disabled={pending === 0}
                  className="flex-1 bg-slate-700 hover:bg-slate-600 disabled:opacity-50 py-3 rounded-xl text-sm font-bold flex items-center justify-center gap-2"
                >
                  <PackageMinus size={18} /> Devolver
                </button>
              </div>
            </div>
          );
        })}
      </div>

      {/* Modal */}
      {modalType && activeStaff && (
        <div className="fixed inset-0 bg-black/80 flex items-center justify-center z-50 p-4">
          <div className="bg-slate-900 border border-slate-700 rounded-3xl p-8 w-full max-w-md">
            <h3 className="text-xl font-black mb-6">
              {modalType === "assign" ? "Entregar Lote" : "Devolver Cartelas"}
            </h3>
            <p className="text-slate-400 mb-4">Voluntário: <strong>{activeStaff.user.name}</strong></p>

            <textarea
              value={batchInput}
              onChange={(e) => setBatchInput(e.target.value)}
              placeholder="Cole os códigos separados por vírgula ou espaço..."
              className="w-full h-32 bg-slate-950 border border-slate-700 rounded-2xl p-4 font-mono text-sm resize-y"
            />

            {message && <div className="mt-4 p-3 rounded-xl bg-emerald-500/10 text-emerald-400 text-sm">{message}</div>}

            <div className="flex gap-3 mt-6">
              <button onClick={() => setModalType(null)} className="flex-1 py-3 border border-slate-700 rounded-2xl">Cancelar</button>
              <button 
                onClick={handleProcess}
                disabled={isPending || !batchInput.trim()}
                className="flex-1 bg-emerald-600 hover:bg-emerald-500 py-3 rounded-2xl font-bold disabled:opacity-50"
              >
                {isPending ? "Processando..." : "Confirmar"}
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/lib/accessPolicy.ts">
// src/lib/accessPolicy.ts
//
// QUEM PODE VER/FAZER O QUÊ nas telas de gestão. Função pura (sem banco), com testes.
//
//  • Administrador (ORG_ADMIN): tudo do próprio evento.
//  • Tesoureiro (voluntário com `canTreasury`): tesouraria, fechamento de caixa, extratos e cartelas por ID
//    (inclusive bloquear/desbloquear). NÃO vê o painel geral, a auditoria nem o ranking e NÃO escolhe fase de preço.
//  • Conselho (voluntário com `canAudit`): SOMENTE LEITURA do painel, relatórios e auditoria.
//  • Suporte da plataforma (SUPER_ADMIN): leitura das telas (menos o ranking). Nenhuma ação.
// As permissões são por evento e combináveis (a mesma pessoa pode ser tesoureira e do conselho).

export type Role = "SUPER_ADMIN" | "ORG_ADMIN" | "STAFF";

export type PageKey =
  | "tesouraria"
  | "fechamento"
  | "extrato"
  | "cartelas"
  | "resultados"
  | "patrocinadores"
  | "auditoria"
  | "ranking";

export type Actor = { role: Role; canTreasury?: boolean; canAudit?: boolean };

const TREASURY_PAGES: ReadonlySet<PageKey> = new Set(["tesouraria", "fechamento", "extrato", "cartelas"]);
const AUDIT_PAGES: ReadonlySet<PageKey> = new Set([
  "fechamento",
  "extrato",
  "cartelas",
  "resultados",
  "patrocinadores",
  "auditoria",
]);

export function canViewPage(actor: Actor, page: PageKey): boolean {
  if (actor.role === "ORG_ADMIN") return true;
  if (actor.role === "SUPER_ADMIN") return page !== "ranking";
  if (actor.role === "STAFF") {
    return (!!actor.canTreasury && TREASURY_PAGES.has(page)) || (!!actor.canAudit && AUDIT_PAGES.has(page));
  }
  return false;
}

/** Entregar, devolver e receber cartelas (tesouraria). */
export const canOperateTreasury = (a: Actor) => a.role === "ORG_ADMIN" || (a.role === "STAFF" && !!a.canTreasury);

/** Bloquear/desbloquear cartela (com justificativa). */
export const canBlockCards = canOperateTreasury;

/** Escolher OUTRA fase de preço no acerto. O tesoureiro só usa a fase vigente. */
export const canChoosePricePhase = (a: Actor) => a.role === "ORG_ADMIN";

/** O ranking é um reconhecimento do administrador. */
export const canSeeRanking = (a: Actor) => a.role === "ORG_ADMIN";

/** Para onde ir quando não pode ver a página. */
export const homeFor = (a: Actor, eventId: string) => (a.role === "STAFF" ? "/gestao" : `/dashboard/${eventId}`);

/** Rótulo do papel de gestão, para mostrar na tela e no log. */
export function managementRoleLabel(a: Actor): string {
  if (a.role === "ORG_ADMIN") return "Administrador";
  if (a.role === "SUPER_ADMIN") return "Suporte da plataforma";
  const labels = [a.canTreasury ? "Tesoureiro" : null, a.canAudit ? "Conselho" : null].filter(Boolean);
  return labels.length ? labels.join(" e ") : "Voluntário";
}
</file>

<file path="src/lib/audit.ts">
// src/lib/audit.ts
//
// Registro de auditoria: quem fez o quê, quando, com qual papel e de onde. É "best-effort": se gravar falhar,
// a operação principal NÃO pode falhar (um sorteio ou um pagamento não pode parar por causa do log).
// O texto de cada ação fica em src/lib/auditLabels.ts.
//
// Cada registro guarda, além dos dados da ação: o NOME e o PAPEL de quem fez (como estavam naquele momento),
// o endereço IP e o aparelho. Serve para o administrador e o conselho investigarem qualquer contestação,
// inclusive de dentro da própria equipe.

import type { Prisma } from "@prisma/client";
import { headers } from "next/headers";
import prisma from "@/lib/prisma";
import { auth } from "@/lib/auth";
import { managementRoleLabel, type Role } from "@/lib/accessPolicy";

type AuditInput = {
  action: string;
  eventId?: string; // ausente nas ações da conta/equipe (não pertencem a um evento)
  tenantId?: string | null;
  metadata?: Record<string, unknown>;
};

/** Monta a linha do log (com as evidências de quem fez). Use em `prisma.auditLog.create({ data })`. */
export async function buildAuditData(input: AuditInput) {
  const session = await auth();

  let ip: string | null = null;
  let ua: string | null = null;
  try {
    const h = await headers();
    ip = (h.get("x-forwarded-for")?.split(",")[0] ?? h.get("x-real-ip") ?? "").trim() || null;
    ua = (h.get("user-agent") ?? "").slice(0, 160) || null;
  } catch {
    // fora de um pedido web (ex.: script): segue sem IP/aparelho
  }

  const role = session?.user?.role as Role | undefined;
  let label: string | null = null;
  if (role === "STAFF" && session?.user?.id && input.eventId) {
    const rows = await prisma.eventStaff.findMany({
      where: { eventId: input.eventId, userId: session.user.id },
      select: { canSell: true, canOperate: true, canVerify: true, canTreasury: true, canAudit: true },
    });
    const mgmt = managementRoleLabel({ role, canTreasury: rows.some((r) => r.canTreasury), canAudit: rows.some((r) => r.canAudit) });
    const duties = [
      rows.some((r) => r.canSell) ? "Vendedor" : null,
      rows.some((r) => r.canOperate) ? "Palco" : null,
      rows.some((r) => r.canVerify) ? "Fiscal" : null,
    ].filter(Boolean);
    label = mgmt !== "Voluntário" ? mgmt : duties.length ? `Voluntário (${duties.join(", ")})` : "Voluntário";
  } else if (role) {
    label = managementRoleLabel({ role });
  }

  return {
    action: input.action,
    userId: session?.user?.id ?? null,
    tenantId: input.tenantId ?? session?.user?.tenantId ?? null,
    metadata: {
      ...(input.eventId ? { eventId: input.eventId } : {}),
      ...(input.metadata ?? {}),
      actor: { name: session?.user?.name ?? null, role: role ?? null, label },
      ip,
      ua,
    } as Prisma.InputJsonValue,
  };
}

export async function logAudit(input: AuditInput) {
  try {
    await prisma.auditLog.create({ data: await buildAuditData(input) });
  } catch (error) {
    console.error("[AUDIT_LOG_ERROR]", input.action, error);
  }
}
</file>

<file path="src/lib/auditLabels.ts">
// src/lib/auditLabels.ts
//
// Catálogo do log de auditoria: nome de cada ação, categoria e a frase em português que a descreve.
// Função pura (sem banco), com testes. As ações são gravadas por logAudit() em src/lib/audit.ts.

export type AuditCategory = "DINHEIRO" | "CARTELAS" | "SORTEIO" | "EQUIPE" | "EVENTO";

export const CATEGORY_LABEL: Record<AuditCategory, string> = {
  DINHEIRO: "Dinheiro",
  CARTELAS: "Cartelas",
  SORTEIO: "Sorteio e ganhadores",
  EQUIPE: "Equipe e permissões",
  EVENTO: "Evento",
};

// `sensitive` = ação que merece atenção do administrador (destaque na tela).
export const AUDIT_ACTIONS: Record<string, { label: string; category: AuditCategory; sensitive?: boolean }> = {
  PAYMENT_REGISTERED: { label: "Pagamento registrado", category: "DINHEIRO" },
  SALE_UNDONE: { label: "Venda desfeita", category: "DINHEIRO", sensitive: true },
  PRICE_TIER_CREATED: { label: "Fase de preço criada", category: "DINHEIRO" },
  PRICE_TIER_DELETED: { label: "Fase de preço apagada", category: "DINHEIRO", sensitive: true },
  TICKET_PRICE_CHANGED: { label: "Preço padrão alterado", category: "DINHEIRO" },
  CARDS_GENERATED: { label: "Cartelas geradas", category: "CARTELAS" },
  CARDS_ASSIGNED: { label: "Cartelas entregues", category: "CARTELAS" },
  CARDS_RETURNED: { label: "Cartelas recolhidas", category: "CARTELAS" },
  TRANSFER_ACCEPTED: { label: "Troca entre voluntários", category: "CARTELAS" },
  CARD_BLOCKED: { label: "Cartela bloqueada", category: "CARTELAS", sensitive: true },
  CARD_UNBLOCKED: { label: "Cartela desbloqueada", category: "CARTELAS", sensitive: true },
  BINGO_ALERT: { label: "Aviso de bingo", category: "SORTEIO" },
  BINGO_RELEASED: { label: "Bingo solto no telão", category: "SORTEIO" },
  BINGO_FALSE_ALARM: { label: "Falso alarme", category: "SORTEIO", sensitive: true },
  ROUND_COMPLETED: { label: "Rodada encerrada", category: "SORTEIO" },
  GAME_RESET: { label: "Globo zerado", category: "SORTEIO", sensitive: true },
  STAFF_PERMISSIONS_CHANGED: { label: "Permissões alteradas", category: "EQUIPE", sensitive: true },
  PIN_RESET: { label: "PIN redefinido", category: "EQUIPE", sensitive: true },
  EVENT_CLOSED: { label: "Evento encerrado", category: "EVENTO", sensitive: true },
  DEMO_MODE: { label: "Modo demonstração", category: "EVENTO", sensitive: true },
};

// Nome de cada permissão (para descrever quem ganhou ou perdeu o quê).
export const PERMISSION_LABEL: Record<string, string> = {
  canSell: "Vender (PDV)",
  canOperate: "Palco",
  canVerify: "Fiscal",
  canTreasury: "Tesouraria",
  canAudit: "Conselho",
};
const PERMISSION_KEYS = ["canSell", "canOperate", "canVerify", "canTreasury", "canAudit"] as const;

/** Destaque na tela: ações sensíveis, e também um acerto em que o administrador usou fase diferente da vigente. */
export function isSensitiveEntry(action: string, md?: Record<string, any> | null): boolean {
  if (AUDIT_ACTIONS[action]?.sensitive) return true;
  if (action === "PAYMENT_REGISTERED" && md?.overridden) return true;
  return false;
}

export const actionsOfCategory = (cat: AuditCategory): string[] =>
  Object.entries(AUDIT_ACTIONS).filter(([, v]) => v.category === cat).map(([k]) => k);

const brl = (cents: unknown) =>
  (Number(cents ?? 0) / 100).toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
const n = (v: unknown) => Number(v ?? 0);
const plural = (count: number, one: string, many: string) => `${count} ${count === 1 ? one : many}`;
const typeLabel = (t: unknown) => (t === "FULL_HOUSE" ? "cartela cheia" : "quina");
const range = (first: unknown, last: unknown) => (first && last ? ` (de ${first} até ${last})` : "");
const dateBR = (iso: unknown) =>
  iso
    ? new Date(String(iso)).toLocaleString("pt-BR", { timeZone: "America/Sao_Paulo", day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit" })
    : "";

/** Frase em português para uma linha do log. `who` traduz o id de um voluntário no nome dele. */
export function describeAudit(action: string, md: Record<string, any> | null | undefined, who: (staffId: string) => string): string {
  const m = md ?? {};
  switch (action) {
    case "PAYMENT_REGISTERED": {
      // Desdobramento do valor (ex.: 3 × R$ 10,00 + 2 × R$ 15,00) para o conselho conferir a conta.
      const parts =
        Array.isArray(m.breakdown) && m.breakdown.length > 0
          ? ` [${(m.breakdown as { price: number; qty: number }[]).map((b) => `${b.qty} × ${brl(b.price)}`).join(" + ")}]`
          : "";
      const phase = m.tier ? ` (fase: ${m.tier})` : "";
      const alert = m.overridden
        ? ` — ATENÇÃO: o administrador aplicou ${m.tier ? `a fase "${m.tier}"` : "o preço padrão"}; a vigente era ${m.vigente ? `"${m.vigente}"` : "o preço padrão"}`
        : "";
      return `Recebeu de ${who(m.staffId)} o acerto de ${plural(n(m.count), "cartela", "cartelas")}: ${brl(m.amount)}${parts}${phase}${m.mode === "all" ? " — tudo o que estava com o voluntário" : ""}${alert}`;
    }
    case "SALE_UNDONE":
      return `Desfez a venda de ${plural((m.codes ?? []).length || n(m.count), "cartela", "cartelas")} (${brl(m.total)}) de ${who(m.staffId)}${(m.codes ?? []).length ? `: ${(m.codes as string[]).join(", ")}` : ""}`;
    case "PRICE_TIER_CREATED":
      return `Criou a fase "${m.name}": quina ${brl(m.quinaPrice)}${m.fullHousePrice ? `, cheia ${brl(m.fullHousePrice)}` : ""}${m.startsAt ? `, a partir de ${dateBR(m.startsAt)}` : ", desde o início"}`;
    case "PRICE_TIER_DELETED":
      return `Apagou a fase de preço${m.name ? ` "${m.name}"` : ""}${m.quinaPrice ? ` (quina ${brl(m.quinaPrice)}${m.fullHousePrice ? `, cheia ${brl(m.fullHousePrice)}` : ""}${m.startsAt ? `, começava em ${dateBR(m.startsAt)}` : ""})` : ""}`;
    case "TICKET_PRICE_CHANGED":
      return `Alterou o preço padrão da ${m.kind === "FULL_HOUSE" ? "cartela cheia" : "cartela"}${m.from != null ? ` de ${brl(m.from)}` : ""} para ${brl(m.price)}`;
    case "CARDS_GENERATED":
      return `Gerou ${plural(n(m.quantity), "cartela", "cartelas")} de ${typeLabel(m.type)}`;
    case "CARDS_ASSIGNED":
      return `Entregou ${plural(n(m.count), "cartela", "cartelas")} a ${who(m.staffId)}${range(m.first, m.last)}${m.mode === "codes" ? " — por códigos" : ""}`;
    case "CARDS_RETURNED":
      return `Recolheu ${plural(n(m.count), "cartela", "cartelas")} de ${who(m.staffId)}`;
    case "TRANSFER_ACCEPTED":
      return `${who(m.fromStaff)} entregou ${plural(n(m.count), "cartela", "cartelas")} a ${who(m.toStaff)}${range(m.first, m.last)}`;
    case "CARD_BLOCKED":
      return `Bloqueou a cartela ${m.shortId}: ${m.reason ?? "sem motivo"}${m.wasPaid ? " (já estava vendida)" : ""}`;
    case "CARD_UNBLOCKED":
      return `Desbloqueou a cartela ${m.shortId}${m.reason ? `: justificativa "${m.reason}"` : ""}`;
    case "STAFF_PERMISSIONS_CHANGED": {
      const target = `${m.targetName ?? "voluntário"}${m.targetUsername ? ` (${m.targetUsername})` : ""}`;
      const on = (f: Record<string, boolean> | null | undefined) =>
        PERMISSION_KEYS.filter((k) => f?.[k]).map((k) => PERMISSION_LABEL[k]);
      if (m.assigned === false) return `Retirou ${target} da equipe do evento`;
      const before = (m.before ?? null) as Record<string, boolean> | null;
      const after = (m.after ?? null) as Record<string, boolean> | null;
      if (!before) return `Escalou ${target} no evento com: ${on(after).join(", ") || "nenhuma permissão"}`;
      const gained = on(after).filter((l) => !on(before).includes(l));
      const lost = on(before).filter((l) => !on(after).includes(l));
      const parts = [gained.length ? `passou a ter ${gained.join(", ")}` : null, lost.length ? `deixou de ter ${lost.join(", ")}` : null].filter(Boolean);
      return `Alterou as permissões de ${target}: ${parts.join("; ") || "sem mudança"}`;
    }
    case "PIN_RESET":
      return `Redefiniu o PIN de ${m.targetName ?? "um voluntário"}${m.targetUsername ? ` (${m.targetUsername})` : ""}`;
    case "BINGO_ALERT":
      return `O fiscal ${m.fiscal ?? ""} avisou bingo: cartela ${m.card}, ganhador "${m.winnerName}"`.replace("fiscal  ", "fiscal ");
    case "BINGO_RELEASED":
      return `Soltou o bingo no telão: cartela ${m.card ?? "?"}, ganhador "${String(m.winnerName ?? "").split(" (Fiscal:")[0]}"`;
    case "BINGO_FALSE_ALARM":
      return `Limpou um aviso de bingo (falso alarme)${m.card ? `: cartela ${m.card}` : ""}`;
    case "ROUND_COMPLETED":
      return `Encerrou a rodada do prêmio "${m.prizeName}"`;
    case "GAME_RESET":
      return "Zerou o globo (reset das pedras sorteadas)";
    case "EVENT_CLOSED":
      return `Encerrou o evento: ${brl(m.totalRevenue)} em ${plural(n(m.cards), "cartela", "cartelas")}`;
    case "DEMO_MODE":
      return "Ativou o modo demonstração (todas as cartelas marcadas como pagas)";
    default:
      return action;
  }
}
</file>

<file path="src/lib/bingoRules.ts">
// src/lib/bingoRules.ts
//
// Regras de bingo (função pura) usadas pelo SERVIDOR (validar o ganhador) e pela MESA do locutor
// ("Na cara do gol"). Antes cada lado fazia a sua conta: a mesa sempre media "cartela cheia",
// mesmo na rodada de QUINA, e mostrava como "faltando" cartelas que já tinham ganho.
//
// Quina = qualquer linha completa: 5 linhas, 5 colunas ou 2 diagonais (o centro de N é livre).

export type BingoMatrix = { B: number[]; I: number[]; N: number[]; G: number[]; O: number[] };

const COLS = ["B", "I", "N", "G", "O"] as const;
const isFree = (col: string, row: number) => col === "N" && row === 2;

/** Os 24 números da cartela (sem o centro livre). */
export function cardNumbers(m: BingoMatrix): number[] {
  const out: number[] = [];
  for (const col of COLS) for (let row = 0; row < 5; row++) if (!isFree(col, row)) out.push(m[col][row]);
  return out;
}

export function evaluateCard(m: BingoMatrix, drawnNumbers: number[]) {
  const drawn = new Set(drawnNumbers);
  const missing = (nums: number[]) => nums.filter((n) => !drawn.has(n)).length;

  const rows = [0, 1, 2, 3, 4].map((row) =>
    COLS.filter((col) => !isFree(col, row)).map((col) => m[col][row])
  );
  const cols = COLS.map((col) => [0, 1, 2, 3, 4].filter((row) => !isFree(col, row)).map((row) => m[col][row]));
  const diag1 = [m.B[0], m.I[1], m.G[3], m.O[4]];
  const diag2 = [m.B[4], m.I[3], m.G[1], m.O[0]];

  const fullMissing = missing(cardNumbers(m));

  return {
    fullMissing, // quantas pedras faltam para a CARTELA CHEIA
    quinaMissing: Math.min(...[...rows, ...cols, diag1, diag2].map(missing)), // para a linha mais próxima
    isFullHouse: fullMissing === 0,
    hasHorizontalQuina: rows.some((l) => missing(l) === 0),
    hasVerticalQuina: cols.some((l) => missing(l) === 0),
    hasDiag1: missing(diag1) === 0,
    hasDiag2: missing(diag2) === 0,
    get hasQuina() {
      return this.hasHorizontalQuina || this.hasVerticalQuina || this.hasDiag1 || this.hasDiag2;
    },
  };
}
</file>

<file path="src/lib/cardHolding.ts">
// src/lib/cardHolding.ts
//
// Cartelas "na mão" de um voluntário e escolha das cartelas num pedido entre voluntários.
// Função pura (sem banco), com testes.
//
// Regra do pedido: o voluntário que LIBERA entrega as ÚLTIMAS N cartelas da pilha dele
// (as de MAIOR código). A tesouraria entrega códigos consecutivos em ordem crescente, então a pilha
// física já está em ordem e "as últimas N" são fáceis de separar sem bipar nada.
// A ordem usada é a de código crescente (dígitos antes de letras), a mesma da impressão.

export type HoldCard = { shortId: string; type?: "QUINA" | "FULL_HOUSE" | null };

const byCode = (a: string, b: string) => (a < b ? -1 : a > b ? 1 : 0);

// Cartela antiga (sem tipo) conta como Quina; cartela cheia só conta como cartela cheia.
export const matchesRequestedType = (cardType: HoldCard["type"], requested: "QUINA" | "FULL_HOUSE") =>
  requested === "FULL_HOUSE" ? cardType === "FULL_HOUSE" : cardType === "QUINA" || !cardType;

export function summarizeHolding(cards: HoldCard[]) {
  const sorted = [...cards].sort((a, b) => byCode(a.shortId, b.shortId));
  const fullHouse = sorted.filter((c) => c.type === "FULL_HOUSE").length;
  return {
    total: sorted.length,
    quina: sorted.length - fullHouse,
    fullHouse,
    first: sorted[0]?.shortId ?? null,
    last: sorted[sorted.length - 1]?.shortId ?? null,
  };
}

/** As N cartelas de MAIOR código do tipo pedido, ou null se o dono tiver menos que N. */
export function pickTransferCards<T extends HoldCard>(
  cards: T[],
  requested: "QUINA" | "FULL_HOUSE",
  quantity: number
): T[] | null {
  if (!Number.isInteger(quantity) || quantity < 1) return null;
  const eligible = cards.filter((c) => matchesRequestedType(c.type, requested));
  if (eligible.length < quantity) return null;
  return [...eligible].sort((a, b) => byCode(b.shortId, a.shortId)).slice(0, quantity);
}
</file>

<file path="src/lib/cardInventory.ts">
// src/lib/cardInventory.ts
//
// Inventário de cartelas por ID: em que estado está cada uma. Função pura, com testes.
//   LIVRE          → na fábrica (sem voluntário e não paga)
//   COM_VOLUNTARIO → entregue a um voluntário, ainda não paga
//   VENDIDA        → paga (vendida no PDV ou acertada na tesouraria)

export type InvCard = {
  shortId: string;
  type?: "QUINA" | "FULL_HOUSE" | null;
  isPaid: boolean;
  eventStaffId: string | null;
  blocked?: boolean;
};

export type CardStatus = "LIVRE" | "COM_VOLUNTARIO" | "VENDIDA" | "BLOQUEADA";

export const cardStatus = (c: Pick<InvCard, "isPaid" | "eventStaffId" | "blocked">): CardStatus =>
  c.blocked ? "BLOQUEADA" : c.isPaid ? "VENDIDA" : c.eventStaffId ? "COM_VOLUNTARIO" : "LIVRE";

const emptyCounts = () => ({ livre: 0, comVoluntario: 0, vendida: 0, bloqueada: 0, total: 0 });

export function summarizeInventory(cards: InvCard[]) {
  const all = emptyCounts();
  const byType = { QUINA: emptyCounts(), FULL_HOUSE: emptyCounts(), SEM_TIPO: emptyCounts() };

  for (const c of cards) {
    const bucket = c.type === "FULL_HOUSE" ? byType.FULL_HOUSE : c.type === "QUINA" ? byType.QUINA : byType.SEM_TIPO;
    const st = cardStatus(c);
    const key = st === "LIVRE" ? "livre" : st === "COM_VOLUNTARIO" ? "comVoluntario" : st === "BLOQUEADA" ? "bloqueada" : "vendida";
    all[key]++; all.total++;
    bucket[key]++; bucket.total++;
  }
  return { ...all, byType };
}

/** Códigos em ordem crescente (a mesma da impressão). */
export const sortedCodes = (cards: Pick<InvCard, "shortId">[]) =>
  cards.map((c) => c.shortId).sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));
</file>

<file path="src/lib/cardPricing.ts">
// src/lib/cardPricing.ts
//
// Tipos de cartela e preços. Função pura (sem banco), usada pelo servidor e pelas telas.
//
//  • Cartela de QUINA        → só concorre a prêmio de Quina; vale o `ticketPrice` do evento.
//  • Cartela de CARTELA CHEIA → só concorre a prêmio de Cartela Cheia; vale o `fullHousePrice`.
//  • Cartela sem tipo (antigas) → valem para qualquer prêmio e custam o `ticketPrice`.

export type CardType = "QUINA" | "FULL_HOUSE";

export const CARD_TYPE_LABEL: Record<CardType, string> = {
  QUINA: "Quina",
  FULL_HOUSE: "Cartela Cheia",
};

export const isCardType = (v: unknown): v is CardType => v === "QUINA" || v === "FULL_HOUSE";

/**
 * Preço (em centavos) de uma cartela.
 * Retorna null quando é cartela cheia e o preço dela ainda não foi definido: nesse caso NÃO se vende
 * (cobrar o preço da quina por engano seria dinheiro errado no caixa).
 */
export function priceForCard(
  type: CardType | null | undefined,
  ticketPrice: number,
  fullHousePrice: number | null | undefined
): number | null {
  if (type === "FULL_HOUSE") return fullHousePrice != null && fullHousePrice > 0 ? fullHousePrice : null;
  return ticketPrice;
}

/** Cartela de um tipo só concorre a prêmio do mesmo tipo. Cartela antiga (sem tipo) vale para todos. */
export function cardCanWin(cardType: string | null | undefined, prizeType: string | null | undefined): boolean {
  return !cardType || cardType === prizeType;
}

/** Agrupa cartelas pelo preço de cada uma. Lança "PRICE_UNDEFINED" se houver cartela cheia sem preço. */
export function groupByPrice<T extends { type?: CardType | null }>(
  cards: T[],
  ticketPrice: number,
  fullHousePrice: number | null | undefined
): Map<number, T[]> {
  const groups = new Map<number, T[]>();
  for (const card of cards) {
    const price = priceForCard(card.type, ticketPrice, fullHousePrice);
    if (price === null) throw new Error("PRICE_UNDEFINED");
    const list = groups.get(price);
    if (list) list.push(card);
    else groups.set(price, [card]);
  }
  return groups;
}
</file>

<file path="src/lib/cashReport.ts">
// src/lib/cashReport.ts
//
// Matemática do FECHAMENTO DE CAIXA (relatório que o tesoureiro assina). Função pura: sem banco,
// para poder ser testada com cenários. Valores no MESMO formato do banco (centavos).

export type PaymentMethodLite = "PIX" | "CASH" | "CARD";

export type CashCard = {
  isPaid: boolean;
  price: number | null;
  eventStaffId: string | null;
  type?: "QUINA" | "FULL_HOUSE" | null;
};
export type CashTx = { method: PaymentMethodLite; amount: number; eventStaffId: string | null };
export type CashStaff = { id: string; name: string };

export type SellerRow = {
  id: string;
  name: string;
  qtd: number;
  pix: number;
  dinheiro: number;
  total: number;
};

const sum = (values: number[]) => values.reduce((acc, v) => acc + v, 0);

export function computeCashReport(input: {
  ticketPrice: number;
  fullHousePrice?: number | null;
  cards: CashCard[];
  transactions: CashTx[];
  sponsorContributions: number[];
  staff: CashStaff[];
}) {
  const { ticketPrice, fullHousePrice, cards, transactions, sponsorContributions, staff } = input;

  // ⚠️ `??` e não `||`: price 0 (cartela do modo demonstração) vale ZERO, não o preço cheio.
  // price null (legado) cai no preço atual do evento.
  // Cartela legada (price null) cai no preço do TIPO dela: cartela cheia usa o preço da cartela cheia.
  const priceOf = (c: CashCard) =>
    c.price ?? (c.type === "FULL_HOUSE" && fullHousePrice && fullHousePrice > 0 ? fullHousePrice : ticketPrice);

  const paidCards = cards.filter((c) => c.isPaid);
  const salesCents = sum(paidCards.map(priceOf));
  const sponsorshipCents = sum(sponsorContributions);

  const pixOf = (txs: CashTx[]) => sum(txs.filter((t) => t.method === "PIX").map((t) => t.amount));
  const cardOf = (txs: CashTx[]) => sum(txs.filter((t) => t.method === "CARD").map((t) => t.amount));

  const pixCents = pixOf(transactions);
  const cardCents = cardOf(transactions);
  // Dinheiro físico = o que foi vendido e não entrou por PIX nem cartão.
  const cashCents = salesCents - pixCents - cardCents;

  // 🔎 Conferência: cartelas pagas × lançamentos de pagamento. Se divergem, o relatório avisa.
  const ledgerCents = sum(transactions.map((t) => t.amount));
  const diffCents = salesCents - ledgerCents;
  const hasDiscrepancy = Math.abs(diffCents) > 0.5;

  // Resumo por tipo de cartela (cartelas antigas, sem tipo, entram em "Quina").
  const byType = {
    QUINA: { qtd: 0, total: 0 },
    FULL_HOUSE: { qtd: 0, total: 0 },
  };
  for (const c of paidCards) {
    const bucket = c.type === "FULL_HOUSE" ? byType.FULL_HOUSE : byType.QUINA;
    bucket.qtd += 1;
    bucket.total += priceOf(c);
  }

  const knownIds = new Set(staff.map((s) => s.id));

  const sellers: SellerRow[] = staff
    .map((s) => {
      const mine = paidCards.filter((c) => c.eventStaffId === s.id);
      const myTx = transactions.filter((t) => t.eventStaffId === s.id);
      const total = sum(mine.map(priceOf));
      const pix = pixOf(myTx);
      return { id: s.id, name: s.name, qtd: mine.length, pix, dinheiro: total - pix - cardOf(myTx), total };
    })
    .filter((r) => r.qtd > 0);

  // Cartelas pagas sem vendedor conhecido (ex.: modo demonstração): aparecem numa linha própria,
  // para a soma da tabela sempre fechar com o total.
  const orphanCards = paidCards.filter((c) => !c.eventStaffId || !knownIds.has(c.eventStaffId));
  if (orphanCards.length > 0) {
    const orphanTx = transactions.filter((t) => !t.eventStaffId || !knownIds.has(t.eventStaffId));
    const total = sum(orphanCards.map(priceOf));
    const pix = pixOf(orphanTx);
    sellers.push({
      id: "sem-vendedor",
      name: "Sem vendedor atribuído",
      qtd: orphanCards.length,
      pix,
      dinheiro: total - pix - cardOf(orphanTx),
      total,
    });
  }

  return {
    cardsGenerated: cards.length,
    cardsPaid: paidCards.length,
    salesCents,
    sponsorshipCents,
    gmvCents: salesCents + sponsorshipCents,
    pixCents,
    cardCents,
    cashCents,
    ledgerCents,
    diffCents,
    hasDiscrepancy,
    byType,
    sellers,
  };
}
</file>

<file path="src/lib/eventAccess.ts">
// src/lib/eventAccess.ts
//
// Guardas de acesso às telas de gestão e às ações da tesouraria. A decisão mora em accessPolicy.ts (pura);
// aqui só buscamos no banco quem é a pessoa e quais permissões ela tem NAQUELE evento.
// O proxy também barra voluntário em /dashboard, mas a guarda de verdade é esta (defesa em profundidade).

import { notFound, redirect } from "next/navigation";
import prisma from "@/lib/prisma";
import { auth } from "@/lib/auth";
import { requireTenant } from "@/lib/requireTenant";
import { canViewPage, homeFor, type Actor, type PageKey, type Role } from "@/lib/accessPolicy";

async function loadActor(role: Role, userId: string, eventId: string): Promise<Actor> {
  if (role !== "STAFF") return { role };
  // Por segurança, se algum dia houver linhas repetidas (usuário, evento), vale a união das permissões.
  const rows = await prisma.eventStaff.findMany({
    where: { eventId, userId },
    select: { canTreasury: true, canAudit: true },
  });
  return { role, canTreasury: rows.some((r) => r.canTreasury), canAudit: rows.some((r) => r.canAudit) };
}

/** Guarda das PÁGINAS de gestão. Devolve o tenant (id e nome) e quem está olhando. */
export async function requirePageAccess(subdomain: string, eventId: string, page: PageKey) {
  const session = await auth();
  if (!session?.user?.id) redirect("/entrar");

  const tenant = await prisma.tenant.findUnique({ where: { subdomain }, select: { id: true, name: true } });
  if (!tenant) notFound();

  const role = session.user.role as Role;
  if (role !== "SUPER_ADMIN" && session.user.tenantId !== tenant.id) redirect("/entrar");

  const actor = await loadActor(role, session.user.id, eventId);
  if (!canViewPage(actor, page)) redirect(role === "STAFF" ? "/gestao" : homeFor(actor, eventId));

  return { id: tenant.id, name: tenant.name, actor, userId: session.user.id as string };
}

/** Guarda das AÇÕES da tesouraria: administrador do tenant OU tesoureiro DESTE evento. */
export async function requireTreasuryAccess(eventId: string) {
  const tenantId = await requireTenant(); // também valida o contrato ativo
  const session = await auth();
  const userId = session?.user?.id as string | undefined;
  if (!userId) throw new Error("Usuário não autenticado.");

  const event = await prisma.event.findFirst({
    where: { id: eventId, tenantId },
    select: { id: true, ticketPrice: true, fullHousePrice: true },
  });
  if (!event) throw new Error("Acesso negado. Evento não encontrado.");

  const role = session?.user?.role as Role;
  if (role === "ORG_ADMIN") return { tenantId, event, isAdmin: true as const, userId };

  const actor = await loadActor(role, userId, eventId);
  if (role === "STAFF" && actor.canTreasury) return { tenantId, event, isAdmin: false as const, userId };

  throw new Error("Sem permissão: apenas o administrador ou o tesoureiro do evento.");
}

/** O voluntário tem alguma permissão de gestão (tesoureiro/conselho) em algum evento? */
export async function hasManagementAccess(userId: string) {
  const n = await prisma.eventStaff.count({
    where: { userId, OR: [{ canTreasury: true }, { canAudit: true }] },
  });
  return n > 0;
}
</file>

