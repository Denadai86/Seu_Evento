<file path="src/lib/qrCode.ts">
// src/lib/qrCode.ts
//
// Lê o código da cartela a partir do que a câmera devolveu. O QR impresso na cartela é uma URL
// (".../verify?event=...&id=ABC123"), mas aceitamos também o código puro. Função pura, com testes.

const CODE = /^[A-Z0-9]{4,10}$/;

export function extractCardCode(raw: string): string | null {
  const text = (raw ?? "").trim();
  if (!text) return null;

  let candidate = text;
  try {
    const url = new URL(text);
    candidate = url.searchParams.get("id") ?? "";
  } catch {
    // não é URL: pode ser o código puro
  }

  const code = candidate.trim().toUpperCase();
  return CODE.test(code) ? code : null;
}
</file>

<file path="src/lib/random.ts">
// src/lib/random.ts
//
// Aleatoriedade criptograficamente segura (CSPRNG) para tudo que importa:
// sorteio das pedras, códigos de cartela, matrizes, PINs e senhas temporárias.
// Math.random() é previsível e não deve ser usado nesses casos.

import { randomInt } from "node:crypto";

/** Inteiro uniforme em [min, maxInclusive]. */
export function secureInt(min: number, maxInclusive: number): number {
  return randomInt(min, maxInclusive + 1);
}

/** Elemento uniforme de um array não vazio. */
export function securePick<T>(items: readonly T[]): T {
  if (items.length === 0) throw new Error("securePick: lista vazia");
  return items[randomInt(0, items.length)];
}
</file>

<file path="src/lib/ranking.ts">
// src/lib/ranking.ts
//
// Ranking de vendedores (SÓ para o administrador, sem metas: serve para premiar com uma prenda).
// Conta tudo que foi creditado ao voluntário: vendas no PDV e cartelas acertadas na tesouraria.
// Função pura, com testes.

export type RankRow = { id: string; name: string; qtd: number; total: number };
export type RankBy = "qtd" | "valor";
export type Ranked = RankRow & { position: number };

export function buildRanking(rows: RankRow[], by: RankBy): Ranked[] {
  const primary = (r: RankRow) => (by === "qtd" ? r.qtd : r.total);
  const secondary = (r: RankRow) => (by === "qtd" ? r.total : r.qtd);

  const sorted = rows
    .filter((r) => r.id !== "sem-vendedor" && r.qtd > 0)
    .sort((a, b) => primary(b) - primary(a) || secondary(b) - secondary(a) || a.name.localeCompare(b.name, "pt-BR"));

  // Empate total (mesmo critério e mesmo desempate) divide a posição: 1º, 1º, 3º…
  const out: Ranked[] = [];
  sorted.forEach((r, i) => {
    const prev = out[i - 1];
    const tied = prev && primary(prev) === primary(r) && secondary(prev) === secondary(r);
    out.push({ ...r, position: tied ? prev.position : i + 1 });
  });
  return out;
}
</file>

