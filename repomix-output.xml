                onClick={handleNextStep} 
                disabled={!hasPrizes} 
                className="flex-1 bg-blue-600 hover:bg-blue-500 disabled:bg-slate-800 disabled:text-slate-600 disabled:cursor-not-allowed text-white font-bold py-4 rounded-xl flex items-center justify-center gap-2 transition-all shadow-lg shadow-blue-900/20"
              >
                {hasPrizes ? "Prêmios definidos, Avançar!" : "Cadastre pelo menos 1 prêmio para avançar"} <ChevronRight size={20} />
              </button>
            </div>
          </div>
        )}

        {/* PASSO 4: GERAÇÃO FÁBRICA DE CARTELAS */}
        {step === 4 && (
          <div className="animate-in fade-in slide-in-from-right-4 duration-300 space-y-6">
            <div className="flex items-center gap-3">
              <div className="bg-pink-500/20 p-3 rounded-xl text-pink-400"><Printer size={24} /></div>
              <div>
                <h3 className="text-xl font-bold text-white">Passo 4: A Fábrica de Cartelas</h3>
                <p className="text-sm text-slate-400">Gere o lote inicial de cartelas do estoque para concluir a preparação.</p>
              </div>
            </div>

            <div className="bg-black/20 p-8 rounded-2xl border border-slate-800 text-center flex flex-col items-center shadow-inner">
              <GenerateCardsButton eventId={event.id} eventName={event.name} fullHousePrice={event.fullHousePrice} />
              <p className="text-[11px] text-slate-500 mt-4 max-w-md leading-relaxed">
                *Nota: Assim que as cartelas forem geradas matemáticas no banco de dados, o Wizard entenderá que o setup acabou e liberará seu Centro de Comando operacional completo!
              </p>
            </div>

            <div className="flex gap-4">
              <button onClick={() => setStep(3)} className="px-6 py-4 rounded-xl font-bold text-slate-400 hover:bg-slate-800 hover:text-white transition-colors">
                Voltar
              </button>
            </div>
          </div>
        )}

      </div>
    </div>
  );
}
</file>

<file path="src/app/[subdomain]/dashboard/[eventId]/extrato/page.tsx">
// src/app/[subdomain]/dashboard/[eventId]/extrato/page.tsx
//
// EXTRATO POR VOLUNTÁRIO: uma folha por voluntário, para o tesoureiro conferir e o voluntário assinar.
// ?staff=<id> imprime só um voluntário.

import prisma from "@/lib/prisma";
import { notFound } from "next/navigation";
import Link from "next/link";
import { ArrowLeft } from "lucide-react";
import PrintButton from "../relatorio/PrintButton";
import { requirePageAccess } from "@/lib/eventAccess";

import { computeCashReport } from "@/lib/cashReport";

const TZ = "America/Sao_Paulo";
const brl = (cents: number) => (cents / 100).toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
const fmtDateTime = (d: Date) =>
  d.toLocaleString("pt-BR", { timeZone: TZ, day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit" });

export default async function ExtratoPage({
  params,
  searchParams,
}: {
  params: Promise<{ subdomain: string; eventId: string }>;
  searchParams: Promise<{ staff?: string }>;
}) {
  const { subdomain, eventId } = await params;
  const { staff: staffFilter } = await searchParams;
  const tenant = await requirePageAccess(subdomain, eventId, "extrato");

  const event = await prisma.event.findFirst({
    where: { id: eventId, tenantId: tenant.id },
    select: {
      name: true,
      ticketPrice: true,
      fullHousePrice: true,
      tenant: { select: { name: true } },
      cards: { select: { shortId: true, type: true, isPaid: true, price: true, eventStaffId: true }, orderBy: { shortId: "asc" } },
      transactions: { select: { method: true, amount: true, eventStaffId: true } },
      staff: { select: { id: true, user: { select: { name: true } } } },
    },
  });
  if (!event) notFound();

  const staff = event.staff.map((s) => ({ id: s.id, name: s.user?.name || "Vendedor" }));
  const report = computeCashReport({
    ticketPrice: event.ticketPrice,
    fullHousePrice: event.fullHousePrice,
    cards: event.cards,
    transactions: event.transactions,
    sponsorContributions: [],
    staff,
  });

  // Mesmo critério do fechamento: price null (cartela antiga) cai no preço do TIPO dela.
  const priceOf = (c: { price: number | null; type: string | null }) =>
    c.price ?? (c.type === "FULL_HOUSE" && event.fullHousePrice && event.fullHousePrice > 0 ? event.fullHousePrice : event.ticketPrice);

  const sheets = staff
    .filter((s) => !staffFilter || s.id === staffFilter)
    .map((s) => {
      const row = report.sellers.find((r) => r.id === s.id) ?? { id: s.id, name: s.name, qtd: 0, pix: 0, dinheiro: 0, total: 0 };
      const sold = event.cards.filter((c) => c.isPaid && c.eventStaffId === s.id);
      const pendingCards = event.cards.filter((c) => !c.isPaid && c.eventStaffId === s.id);
      const byPrice = new Map<number, string[]>();
      for (const c of sold) {
        const p = priceOf(c);
        byPrice.set(p, [...(byPrice.get(p) ?? []), c.shortId]);
      }
      return { ...s, row, byPrice: [...byPrice.entries()].sort((a, b) => a[0] - b[0]), pendingCards };
    })
    .filter((s) => s.row.qtd > 0 || s.pendingCards.length > 0);

  if (staffFilter && sheets.length === 0) notFound();

  return (
    <div className="min-h-screen bg-slate-100 text-slate-900 font-sans pb-20 print:bg-white print:pb-0">
      <header className="print:hidden bg-[#0b0f14] text-white p-4 sticky top-0 z-50 shadow-md">
        <div className="max-w-3xl mx-auto flex justify-between items-center">
          <div className="flex items-center gap-4">
            <Link href={tenant.actor.role === "STAFF" ? "/gestao" : `/dashboard/${eventId}/resultados`} className="p-2 bg-slate-800 hover:bg-slate-700 rounded-xl transition">
              <ArrowLeft size={20} />
            </Link>
            <h1 className="font-bold">Extrato por Voluntário • {sheets.length} folha{sheets.length === 1 ? "" : "s"}</h1>
          </div>
          <PrintButton />
        </div>
      </header>

      <main className="max-w-3xl mx-auto mt-8 print:mt-0 space-y-8 print:space-y-0">
        {sheets.length === 0 && (
          <div className="bg-white p-10 rounded-xl text-center text-slate-500">Nenhum voluntário com vendas ou cartelas em mãos.</div>
        )}

        {sheets.map((s, i) => (
          <article key={s.id} className={`bg-white p-10 rounded-xl shadow-xl print:shadow-none print:rounded-none ${i < sheets.length - 1 ? "break-after-page" : ""}`}>
            <div className="border-b-2 border-slate-200 pb-5 mb-6 flex justify-between items-end">
              <div>
                <p className="text-sm font-bold text-slate-500 uppercase tracking-widest">{event.tenant.name}</p>
                <h1 className="text-2xl font-black">{event.name}</h1>
                <p className="text-slate-500">Extrato do voluntário</p>
              </div>
              <div className="text-right">
                <p className="text-sm font-bold text-slate-400">Emitido em</p>
                <p className="font-mono text-slate-800 text-sm">{fmtDateTime(new Date())}</p>
              </div>
            </div>

            <h2 className="text-3xl font-black mb-6">{s.name}</h2>

            <div className="grid grid-cols-4 gap-3 mb-8">
              {[
                ["Cartelas vendidas", `${s.row.qtd}`],
                ["Em PIX", brl(s.row.pix)],
                ["Em dinheiro", brl(s.row.dinheiro)],
                ["Total", brl(s.row.total)],
              ].map(([label, value]) => (
                <div key={label} className="bg-slate-50 border border-slate-200 rounded-xl p-3">
                  <p className="text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">{label}</p>
                  <p className="text-lg font-black">{value}</p>
                </div>
              ))}
            </div>

            <h3 className="text-sm font-black uppercase tracking-wider text-slate-600 mb-2">Cartelas vendidas</h3>
            {s.byPrice.length === 0 ? (
              <p className="text-sm text-slate-400 mb-6">Nenhuma cartela vendida.</p>
            ) : (
              <div className="space-y-3 mb-6">
                {s.byPrice.map(([price, codes]) => (
                  <div key={price}>
                    <p className="text-sm font-bold">{brl(price)} • {codes.length} cartela{codes.length === 1 ? "" : "s"}</p>
                    <p className="font-mono text-[11px] text-slate-600 leading-relaxed break-words">{codes.join("  ")}</p>
                  </div>
                ))}
              </div>
            )}

            <h3 className="text-sm font-black uppercase tracking-wider text-slate-600 mb-2">
              Cartelas ainda com o voluntário (não acertadas)
            </h3>
            {s.pendingCards.length === 0 ? (
              <p className="text-sm text-slate-400 mb-6">Nenhuma.</p>
            ) : (
              <div className="mb-6">
                <p className="text-sm font-bold">{s.pendingCards.length} cartela{s.pendingCards.length === 1 ? "" : "s"}</p>
                <p className="font-mono text-[11px] text-slate-600 leading-relaxed break-words">
                  {s.pendingCards.map((c) => c.shortId).join("  ")}
                </p>
              </div>
            )}

            <div className="grid grid-cols-2 gap-12 mt-16 pt-2">
              <div className="border-t border-slate-800 pt-2 text-center text-xs text-slate-500">Voluntário — {s.name}</div>
              <div className="border-t border-slate-800 pt-2 text-center text-xs text-slate-500">Tesouraria</div>
            </div>
          </article>
        ))}
      </main>
    </div>
  );
}
</file>

<file path="src/app/[subdomain]/dashboard/[eventId]/patrocinadores/page.tsx">
// src/app/[subdomain]/dashboard/[eventId]/patrocinadores/page.tsx
//
// Relatório de EXPOSIÇÃO de patrocinadores: a prova de entrega que o organizador mostra
// ao patrocinador. Versão por patrocinador: ?sponsor=<id> (mostra só os dados dele).

import prisma from "@/lib/prisma";
import { notFound } from "next/navigation";
import Link from "next/link";
import { ArrowLeft, Megaphone, Gift, Clock } from "lucide-react";
import PrintButton from "../relatorio/PrintButton";
import { requirePageAccess } from "@/lib/eventAccess";

import { sponsorOrderBy } from "@/lib/sponsorRotation";
import { buildSponsorReport, formatDuration, SCREEN_CAP_SECONDS } from "@/lib/sponsorReport";

const TZ = "America/Sao_Paulo";
const fmtDateTime = (d: Date) =>
  d.toLocaleString("pt-BR", { timeZone: TZ, day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit" });
const fmtTime = (d: Date) => d.toLocaleTimeString("pt-BR", { timeZone: TZ, hour: "2-digit", minute: "2-digit" });
const fmtMoney = (cents: number) => (cents / 100).toLocaleString("pt-BR", { style: "currency", currency: "BRL" });

export default async function PatrocinadoresPage({
  params,
  searchParams,
}: {
  params: Promise<{ subdomain: string; eventId: string }>;
  searchParams: Promise<{ sponsor?: string }>;
}) {
  const { subdomain, eventId } = await params;
  const { sponsor: sponsorFilter } = await searchParams;

  const tenant = await requirePageAccess(subdomain, eventId, "patrocinadores");

  const event = await prisma.event.findFirst({
    where: { id: eventId, tenantId: tenant.id },
    select: {
      name: true,
      tenant: { select: { name: true } },
      sponsors: { orderBy: sponsorOrderBy(), select: { id: true, name: true, logoUrl: true, contribution: true } },
      prizes: { select: { sponsorId: true, prizeName: true, isCompleted: true } },
    },
  });
  if (!event) notFound();

  const exposures = await prisma.sponsorExposure.findMany({
    where: { eventId },
    orderBy: { createdAt: "asc" },
    select: { sponsorId: true, sponsorName: true, createdAt: true },
  });

  const report = buildSponsorReport({ exposures, prizes: event.prizes, sponsors: event.sponsors });

  // Versão para UM patrocinador: nunca mostra os números dos outros.
  const rows = sponsorFilter ? report.rows.filter((r) => r.key === sponsorFilter) : report.rows;
  if (sponsorFilter && rows.length === 0) notFound();
  const single = sponsorFilter ? rows[0] : null;

  return (
    <div className="min-h-screen bg-slate-100 text-slate-900 font-sans pb-20">
      <header className="print:hidden bg-[#0b0f14] text-white p-4 sticky top-0 z-50 shadow-md">
        <div className="max-w-4xl mx-auto flex justify-between items-center">
          <div className="flex items-center gap-4">
            <Link href={sponsorFilter ? `/dashboard/${eventId}/patrocinadores` : tenant.actor.role === "STAFF" ? "/gestao" : `/dashboard/${eventId}`} className="p-2 bg-slate-800 hover:bg-slate-700 rounded-xl transition">
              <ArrowLeft size={20} />
            </Link>
            <h1 className="font-bold">{sponsorFilter ? "Voltar ao relatório geral" : "Voltar ao Painel"}</h1>
          </div>
          <PrintButton />
        </div>
      </header>

      <main className="max-w-4xl mx-auto mt-8 bg-white p-10 rounded-xl shadow-xl print:shadow-none print:p-0 print:mt-0">
        <div className="border-b-2 border-slate-200 pb-6 mb-8 flex justify-between items-end">
          <div>
            <p className="text-sm font-bold text-slate-500 uppercase tracking-widest">{event.tenant.name}</p>
            <h1 className="text-3xl font-black text-slate-900 mt-1">{event.name}</h1>
            <p className="text-slate-500 mt-1">
              {single ? `Relatório de Exposição — ${single.name}` : "Relatório de Exposição de Patrocinadores"}
            </p>
          </div>
          <div className="text-right">
            <p className="text-sm font-bold text-slate-400">Gerado em</p>
            <p className="font-mono text-slate-800">{fmtDateTime(new Date())}</p>
          </div>
        </div>

        {report.totalBalls === 0 ? (
          <div className="bg-slate-50 border border-slate-200 rounded-2xl p-8 text-center text-slate-600">
            <p className="font-bold text-slate-800 mb-2">Nenhuma pedra patrocinada registrada neste evento.</p>
            <p className="text-sm">
              O registro de exposição acontece a cada sorteio feito com patrocinadores cadastrados. Eventos sorteados
              antes desta função existir não têm o registro, e ele não pode ser reconstruído depois.
            </p>
          </div>
        ) : (
          <>
            <section className="mb-10">
              <div className="grid grid-cols-3 gap-4">
                <div className="bg-slate-50 p-4 rounded-xl border border-slate-200">
                  <p className="text-xs text-slate-500 font-bold uppercase tracking-wider mb-1">Pedras sorteadas</p>
                  <p className="text-3xl font-black text-slate-800">{report.totalBalls}</p>
                </div>
                <div className="bg-slate-50 p-4 rounded-xl border border-slate-200">
                  <p className="text-xs text-slate-500 font-bold uppercase tracking-wider mb-1">Duração do sorteio</p>
                  <p className="text-3xl font-black text-slate-800">{formatDuration(report.spanSeconds)}</p>
                  {report.firstAt && report.lastAt && (
                    <p className="text-xs text-slate-400 mt-1">
                      das {fmtTime(report.firstAt)} às {fmtTime(report.lastAt)}
                    </p>
                  )}
                </div>
                <div className="bg-slate-50 p-4 rounded-xl border border-slate-200">
                  <p className="text-xs text-slate-500 font-bold uppercase tracking-wider mb-1">Patrocinadores</p>
                  <p className="text-3xl font-black text-slate-800">{event.sponsors.length}</p>
                </div>
              </div>
            </section>

            <section className="space-y-5">
              {rows.map((row) => (
                <article key={row.key} className="border-2 border-slate-200 rounded-2xl p-6 break-inside-avoid">
                  <div className="flex items-center justify-between gap-4 mb-5">
                    <div className="flex items-center gap-4 min-w-0">
                      {row.logoUrl ? (
                        // eslint-disable-next-line @next/next/no-img-element
                        <img src={row.logoUrl} alt={row.name} className="h-14 max-w-[8rem] object-contain" />
                      ) : (
                        <div className="h-14 w-14 rounded-xl bg-slate-100 flex items-center justify-center text-slate-400">
                          <Megaphone size={22} />
                        </div>
                      )}
                      <div className="min-w-0">
                        <h2 className="text-xl font-black text-slate-900 truncate">{row.name}</h2>
                        {row.removed && <p className="text-xs text-slate-400">patrocinador removido do evento depois do sorteio</p>}
                        {row.contribution > 0 && <p className="text-sm text-slate-500">Cota: {fmtMoney(row.contribution)}</p>}
                      </div>
                    </div>
                    {!sponsorFilter && row.id && (
                      <Link
                        href={`/dashboard/${eventId}/patrocinadores?sponsor=${row.id}`}
                        className="print:hidden shrink-0 text-xs font-bold text-emerald-700 hover:text-emerald-900 underline underline-offset-2"
                      >
                        Versão para o patrocinador
                      </Link>
                    )}
                  </div>

                  <div className="grid grid-cols-3 gap-4">
                    <div>
                      <p className="text-xs text-slate-500 font-bold uppercase tracking-wider mb-1">Pedras oferecidas</p>
                      <p className="text-2xl font-black text-slate-800">{row.balls}</p>
                      <p className="text-xs text-slate-400">{row.sharePct.toFixed(0)}% das pedras</p>
                    </div>
                    <div>
                      <p className="text-xs text-slate-500 font-bold uppercase tracking-wider mb-1 flex items-center gap-1">
                        <Clock size={12} /> Tempo em tela (estimado)
                      </p>
                      <p className="text-2xl font-black text-slate-800">{formatDuration(row.screenSeconds)}</p>
                      <p className="text-xs text-slate-400">cartão &quot;Pedra oferecida por&quot;</p>
                    </div>
                    <div>
                      <p className="text-xs text-slate-500 font-bold uppercase tracking-wider mb-1 flex items-center gap-1">
                        <Gift size={12} /> Prêmios oferecidos
                      </p>
                      <p className="text-2xl font-black text-slate-800">{row.prizes.length}</p>
                      <p className="text-xs text-slate-400">{row.prizesDelivered} já entregue(s)</p>
                    </div>
                  </div>

                  {row.prizes.length > 0 && (
                    <ul className="mt-4 text-sm text-slate-600 list-disc list-inside">
                      {row.prizes.map((p, i) => (
                        <li key={i}>
                          {p.prizeName} {p.isCompleted ? "— entregue" : "— pendente"}
                        </li>
                      ))}
                    </ul>
                  )}

                  {row.id && (
                    <p className="mt-4 text-xs text-slate-400">
                      Além disso, a marca ficou visível na faixa de patrocinadores do telão durante todo o sorteio.
                    </p>
                  )}
                </article>
              ))}
            </section>

            <p className="mt-10 text-xs text-slate-400 leading-relaxed border-t border-slate-200 pt-4">
              Como ler: &quot;pedras oferecidas&quot; e &quot;prêmios&quot; são registros do sistema. O &quot;tempo em tela&quot; é uma
              estimativa: soma o intervalo até a próxima pedra (no máximo {formatDuration(SCREEN_CAP_SECONDS)} por pedra) e
              pressupõe o telão ligado durante o sorteio.
            </p>
          </>
        )}
      </main>
    </div>
  );
}
</file>

<file path="src/app/[subdomain]/dashboard/[eventId]/resultados/page.tsx">
// src/app/[subdomain]/dashboard/[eventId]/resultados/page.tsx
//
// PAINEL DE RESULTADOS: visão de tudo que o evento já registrou. Só mostra o que o sistema sabe
// (vendas e acertos têm horário; a data de uma venda em papel não é registrada).
// Os documentos para IMPRIMIR (caixa, patrocinadores, extratos) abrem com um clique.

import prisma from "@/lib/prisma";
import { notFound } from "next/navigation";
import Link from "next/link";
import { ArrowLeft, Printer, FileSignature, Megaphone, ReceiptText, AlertTriangle, Ticket, ShieldCheck } from "lucide-react";
import { requirePageAccess } from "@/lib/eventAccess";
import { canSeeRanking } from "@/lib/accessPolicy";
import { computeCashReport } from "@/lib/cashReport";
import { buildTimeline, buildByPrice, buildStock, pendingByStaff, buildDrawSummary } from "@/lib/dashboardData";
import { buildSponsorReport, formatDuration } from "@/lib/sponsorReport";
import TimelineChart from "@/components/charts/TimelineChart";
import HBarChart from "@/components/charts/HBarChart";
import DonutChart from "@/components/charts/DonutChart";
import StackBar from "@/components/charts/StackBar";
import { brl, COLORS } from "@/components/charts/format";
import AutoRefresh from "./AutoRefresh";
import { buildRanking, type RankBy } from "@/lib/ranking";

const TZ = "America/Sao_Paulo";
const fmtClock = (d: Date) => d.toLocaleTimeString("pt-BR", { timeZone: TZ, hour: "2-digit", minute: "2-digit" });
const pct = (part: number, total: number) => (total > 0 ? Math.round((part / total) * 100) : 0);

function Card({ title, children, className = "" }: { title: string; children: React.ReactNode; className?: string }) {
  return (
    <section className={`bg-[#111827] border border-emerald-900/30 rounded-3xl p-6 shadow-xl ${className}`}>
      <h2 className="text-[11px] font-black uppercase tracking-[0.2em] text-slate-500 mb-4">{title}</h2>
      {children}
    </section>
  );
}

function Kpi({ label, value, sub, accent = "text-white" }: { label: string; value: string; sub?: string; accent?: string }) {
  return (
    <div className="bg-[#111827] border border-emerald-900/30 rounded-2xl p-5 shadow-lg">
      <p className="text-[11px] font-black uppercase tracking-[0.18em] text-slate-500 mb-2">{label}</p>
      <p className={`text-2xl sm:text-3xl font-black leading-none ${accent}`}>{value}</p>
      {sub && <p className="text-xs text-slate-500 mt-2">{sub}</p>}
    </div>
  );
}

function Legend({ items }: { items: { label: string; value: string; color: string }[] }) {
  return (
    <ul className="space-y-2 text-sm">
      {items.map((i) => (
        <li key={i.label} className="flex items-center justify-between gap-4">
          <span className="flex items-center gap-2 text-slate-300">
            <span className="w-3 h-3 rounded-sm" style={{ background: i.color }} />
            {i.label}
          </span>
          <span className="font-bold text-white">{i.value}</span>
        </li>
      ))}
    </ul>
  );
}

export default async function ResultadosPage({
  params,
  searchParams,
}: {
  params: Promise<{ subdomain: string; eventId: string }>;
  searchParams: Promise<{ rank?: string }>;
}) {
  const { subdomain, eventId } = await params;
  const { rank } = await searchParams;
  const rankBy: RankBy = rank === "qtd" ? "qtd" : "valor";
  const tenant = await requirePageAccess(subdomain, eventId, "resultados");

  const event = await prisma.event.findFirst({
    where: { id: eventId, tenantId: tenant.id },
    select: {
      name: true,
      ticketPrice: true,
      fullHousePrice: true,
      tenant: { select: { name: true } },
      sponsors: { select: { id: true, name: true, logoUrl: true, contribution: true } },
      prizes: { select: { sponsorId: true, prizeName: true, isCompleted: true } },
      cards: { select: { type: true, isPaid: true, isSold: true, price: true, eventStaffId: true, blocked: true } },
      transactions: { select: { method: true, amount: true, eventStaffId: true, cardId: true, createdAt: true } },
      staff: { select: { id: true, user: { select: { name: true } } } },
    },
  });
  if (!event) notFound();

  const exposures = await prisma.sponsorExposure.findMany({
    where: { eventId },
    orderBy: { createdAt: "asc" },
    select: { sponsorId: true, sponsorName: true, createdAt: true },
  });

  // 🧮 Toda a matemática mora em src/lib (funções puras, com testes).
  const staff = event.staff.map((s) => ({ id: s.id, name: s.user?.name || "Vendedor" }));
  const report = computeCashReport({
    ticketPrice: event.ticketPrice,
    fullHousePrice: event.fullHousePrice,
    cards: event.cards,
    transactions: event.transactions,
    sponsorContributions: event.sponsors.map((s) => s.contribution),
    staff,
  });
  const timeline = buildTimeline(event.transactions);
  const byPrice = buildByPrice(event.cards, event.ticketPrice, event.fullHousePrice);
  const stock = buildStock(event.cards);
  const pending = pendingByStaff(event.cards);
  const draw = buildDrawSummary(exposures.map((e) => e.createdAt));
  const sponsorReport = buildSponsorReport({ exposures, prizes: event.prizes, sponsors: event.sponsors });

  const avgTicket = report.cardsPaid > 0 ? report.salesCents / report.cardsPaid : 0;
  const prizesDelivered = event.prizes.filter((p) => p.isCompleted).length;
  const base = `/dashboard/${eventId}`;

  const sellersSorted = [...report.sellers].sort((a, b) => b.total - a.total);
  const ranking = buildRanking(report.sellers, rankBy);
  const methodSegments = [
    { label: "PIX", value: report.pixCents, color: COLORS.pix },
    { label: "Dinheiro", value: report.cashCents, color: COLORS.cash },
    ...(report.cardCents > 0 ? [{ label: "Cartão", value: report.cardCents, color: "#a78bfa" }] : []),
  ];
  const typeSegments = [
    { label: "Quina", value: report.byType.QUINA.qtd, color: COLORS.quina },
    { label: "Cartela cheia", value: report.byType.FULL_HOUSE.qtd, color: COLORS.full },
  ];

  return (
    <div className="min-h-screen bg-[#0b0f14] text-slate-200 font-sans pb-20">
      {/* HEADER */}
      <header className="sticky top-0 z-50 bg-[#0b0f14]/85 backdrop-blur-md border-b border-emerald-900/30">
        <div className="max-w-7xl mx-auto px-6 py-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
          <div className="flex items-center gap-4">
            <Link href={tenant.actor.role === "STAFF" ? "/gestao" : base} className="p-2 bg-slate-800/50 hover:bg-slate-800 rounded-xl transition-colors text-slate-400 hover:text-white">
              <ArrowLeft size={20} />
            </Link>
            <div>
              <h1 className="text-xl font-black text-white tracking-wide">{event.name}</h1>
              <p className="text-emerald-500/70 text-xs font-bold uppercase tracking-widest">
                Painel de Resultados • {event.tenant.name}
              </p>
            </div>
          </div>
          <div className="flex items-center gap-3">
            <span className="text-xs text-slate-500">Atualizado às {fmtClock(new Date())}</span>
            <AutoRefresh seconds={30} />
          </div>
        </div>
      </header>

      <main className="max-w-7xl mx-auto px-6 pt-8 space-y-6">
        {/* IMPRESSÕES AO CLIQUE */}
        <section className="bg-[#111827] border border-emerald-900/30 rounded-3xl p-5 flex flex-col lg:flex-row lg:items-center gap-4">
