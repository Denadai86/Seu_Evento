                    <th className="py-2 pr-4 text-right">Cartelas</th>
                    <th className="py-2 pr-4 text-right">PIX</th>
                    <th className="py-2 pr-4 text-right">Dinheiro</th>
                    <th className="py-2 pr-4 text-right">Total</th>
