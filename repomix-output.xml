 * @param amount Valor da cobrança (opcional)
 */
export function generatePixPayload(pixKey: string, merchantName: string, merchantCity: string, amount?: number): string {
  const sanitize = (str: string, maxLen: number) => 
    str.normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-zA-Z0-9 ]/g, "").substring(0, maxLen).trim();

  const name = sanitize(merchantName, 25) || "RECEBEDOR";
  const city = sanitize(merchantCity, 15) || "CIDADE";
  
  let payload = "000201"; // Payload Format Indicator
  
  // Merchant Account Information
  const gui = "0014br.gov.bcb.pix";
  const keyInfo = `01${pixKey.length.toString().padStart(2, '0')}${pixKey}`;
  const accountInfo = `${gui}${keyInfo}`;
  payload += `26${accountInfo.length.toString().padStart(2, '0')}${accountInfo}`;
  
  payload += "52040000"; // Merchant Category Code
  payload += "5303986";  // Transaction Currency (BRL)
  
  // Transaction Amount
  if (amount && amount > 0) {
    const amtStr = amount.toFixed(2);
    payload += `54${amtStr.length.toString().padStart(2, '0')}${amtStr}`;
  }
  
  payload += "5802BR"; // Country Code
  
  // Merchant Name
  payload += `59${name.length.toString().padStart(2, '0')}${name}`;
  // Merchant City
  payload += `60${city.length.toString().padStart(2, '0')}${city}`;
  
  // Additional Data Field Template (TxId)
  payload += "62070503***"; 
  
  // CRC16 (Sempre no final)
  payload += "6304";
  
  // Função para calcular CRC16-CCITT
  let crc = 0xFFFF;
  for (let i = 0; i < payload.length; i++) {
    crc ^= payload.charCodeAt(i) << 8;
    for (let j = 0; j < 8; j++) {
      if ((crc & 0x8000) !== 0) {
        crc = (crc << 1) ^ 0x1021;
      } else {
        crc = crc << 1;
      }
    }
  }
  
  const crcHex = (crc & 0xFFFF).toString(16).toUpperCase().padStart(4, '0');
  return payload + crcHex;
}
</file>

<file path="src/lib/priceTiers.ts">
// src/lib/priceTiers.ts
//
// Fases de preço (pré-venda → perto do evento → no evento). Função pura, sem banco.
//
// Regras:
//  • Fase vigente = a de MAIOR `startsAt` que já começou (startsAt <= agora).
//    Fase sem data (`startsAt` null) vale "desde o início" e só vigora se nenhuma outra começou.
//  • Nenhuma fase vigente → vale o preço PADRÃO do evento.
//  • Fase sem preço de cartela cheia → usa o preço padrão da cartela cheia (nunca fica sem preço por isso).

export type TierLite = {
  id: string;
  name: string;
  quinaPrice: number;
  fullHousePrice: number | null;
  startsAt: Date | null;
};

export type BasePrices = { ticketPrice: number; fullHousePrice: number | null | undefined };
export type ResolvedPrices = { quina: number; fullHouse: number | null; tier: TierLite | null };

export function activeTier(tiers: TierLite[], now: Date = new Date()): TierLite | null {
  const started = tiers.filter((t) => !t.startsAt || t.startsAt.getTime() <= now.getTime());
  if (started.length === 0) return null;
  return [...started].sort(
    (a, b) => (b.startsAt?.getTime() ?? -Infinity) - (a.startsAt?.getTime() ?? -Infinity)
  )[0];
}

/** Preços de uma fase específica (usado também quando a tesouraria escolhe a fase manualmente). */
export function pricesOfTier(base: BasePrices, tier: TierLite): ResolvedPrices {
  return { quina: tier.quinaPrice, fullHouse: tier.fullHousePrice ?? base.fullHousePrice ?? null, tier };
}

/** Preços em vigor AGORA. */
export function currentPrices(base: BasePrices, tiers: TierLite[], now: Date = new Date()): ResolvedPrices {
  const tier = activeTier(tiers, now);
  if (tier) return pricesOfTier(base, tier);
  return { quina: base.ticketPrice, fullHouse: base.fullHousePrice ?? null, tier: null };
}
</file>

<file path="src/lib/projectorSync.ts">
// src/lib/projectorSync.ts
//
// Sincronia INSTANTÂNEA entre a mesa do locutor e o telão quando os dois estão no MESMO
// navegador e na mesma origem (ex.: telão aberto como pop-up / outra janela do Firefox no
// notebook ligado ao HDMI). Não passa pela rede: o telão atualiza no mesmo instante.
// O polling (SWR) continua funcionando como reserva para telão em OUTRO aparelho.

export type SyncMessage =
  | { type: "refresh" }
  | {
      type: "draw";
      drawnNumbers: number[];
      currentSponsor: unknown;
      nextSponsor: unknown;
    };

const channelName = (eventId: string) => `seuevento:bingo:${eventId}`;
const supported = () => typeof window !== "undefined" && "BroadcastChannel" in window;

export function notifyProjector(eventId: string, message: SyncMessage = { type: "refresh" }) {
  if (!supported()) return;
  try {
    const channel = new BroadcastChannel(channelName(eventId));
    channel.postMessage(message);
    channel.close();
  } catch {
    // sem BroadcastChannel (ou bloqueado): o polling cobre
  }
}

export function listenProjector(eventId: string, onMessage: (message: SyncMessage) => void) {
  if (!supported()) return () => {};
  const channel = new BroadcastChannel(channelName(eventId));
  channel.onmessage = (event) => {
    if (event.data && typeof event.data === "object") onMessage(event.data as SyncMessage);
  };
  return () => channel.close();
}
</file>

