            ? "bg-slate-700 border-slate-500 text-white"
            : "bg-slate-900 border-slate-700 text-slate-500 hover:border-slate-500"
        }`}
      >
        {label}
      </button>
    ))}
  </div>

  <PrintOptions eventId={eventId} type={printType} />
</div>

    </div>
  );
}
